{
  "version": "0.3.0",
  "title": "我们的旅行季",
  "opening_seconds": 50,
  "main_target_seconds": 600,
  "never_pad_short_material": true,
  "format": {
    "width": 1920,
    "height": 1080,
    "fps": 30
  },
  "caption_theme": "huashao_v2",
