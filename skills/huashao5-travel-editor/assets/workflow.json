    "duck_under_speech": true,
    "loop": false
  },
  "quality": {
    "require_verified_dialogue": true,
    "name_mapping": "user_provided_only",
    "continuous_viewing_required": true,
    "listening_required": true
  },
  "ending": {
    "enabled": true,
    "mode": "in_place",
    "target_seconds": 3,
    "added_seconds": 0,
    "picture": "使用正片原有最后一个镜头，不追加回顾或合照",
    "default_title": "下次见",
    "branding": "inherit_user_selection",
    "music": "preserve_existing_audio_no_new_cue",
    "video_fade_out": 1,
    "audio_fade_out": 1.2
  }
}
